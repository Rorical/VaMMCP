root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = tab
indent_size = 4
# net35 / LangVersion 7.3 — see docs/DEVELOPMENT.md before reaching for newer syntax
csharp_new_line_before_open_brace = none
csharp_prefer_braces = true:suggestion

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
