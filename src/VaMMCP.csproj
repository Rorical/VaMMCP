<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>VaMMCP</AssemblyName>
    <RootNamespace>VaMMCP</RootNamespace>
    <Version>1.0.0</Version>
    <Description>MCP (Model Context Protocol) server inside Virt-A-Mate, as a BepInEx plugin</Description>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <!--
      VaM install root. Override at build time with:
        dotnet build -p:VaMRoot=D:\path\to\VaM
      or set the VAM_ROOT environment variable (scripts/deploy.sh reads it).
      Default: two levels above this file (i.e. the VaM folder when the repo sits inside it).
    -->
    <VaMRoot Condition="'$(VaMRoot)' == '' and '$(VAM_ROOT)' != ''">$(VAM_ROOT)</VaMRoot>
    <VaMRoot Condition="'$(VaMRoot)' == ''">..\..</VaMRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2018.1.9" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(VaMRoot)\VaM_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
